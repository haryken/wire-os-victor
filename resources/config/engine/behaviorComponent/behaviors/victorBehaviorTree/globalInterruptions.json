{
  "behaviorID" : "GlobalInterruptions",
  "behaviorClass" : "DispatcherStrictPriority",

  "interruptActiveBehavior": true,

  "behaviors": [
    "MandatoryPhysicalReactions",
    "SDKDefault",
    "SDKLock",
    "TriggerWordDetected",
    "SingletonWallTimeCoordinator",
    "TimerUtilityCoordinator",
    "WeatherResponses",
    "TakeAPhotoCoordinator",
    "ReactToRobotShaken",
    "ReactToTouchPetting",
    "SimpleVoiceResponses", // these are simple voice commands that we want to ignore obstacles
    // Cube play must beat ReactToObstacle: prox often sees the cube/hand as a "sudden
    // obstacle" and ForceClears play_keepaway before VoiceFeatures can run (~90 ticks).
    // Keep above ReactToObstacle like SimpleVoiceResponses; no FakeTrigger/mic reopen.
    "KeepawayVoiceCommand",
    "PopAWheelieVoiceCommand",
    "RollCubeVoiceCommand",
    "DoATrickVoiceCommand",
    // Sing must beat ReactToObstacle like keepaway; otherwise prox "obstacle"
    // ForceClears imperative_sing (~90 ticks) before VoiceFeatures runs.
    "SingingVoiceCommand",
    "ReactToObstacle",
    "SingletonPounceDispatcher",
    "VoiceFeatures",
    "ChangeEyeColor",
    "ReactToUnclaimedIntent",
    "HeldInPalmDispatcher",
    "WhileInAirDispatcher",
    "PetDetection",
    "ReactToPutDown",
    "OptionalReactions",
    "StayOnChargerUntilCharged", // delegate includes ReactToSoundAwake
    "ReactToSoundAwake",
    "ConfirmHabitat",
    "HighLevelAI"
  ]
}
